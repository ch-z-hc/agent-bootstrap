# agent-bootstrap: minimal info to set up a new PC.
# Copy to bootstrap.env, fill the 3 required values, then:  py bootstrap.py
# Old PC can generate this automatically:  py bootstrap.py export

# --- required (3 lines) ---
GPT_BASE_URL=http://your-proxy:8081
GPT_API_KEY=sk-xxxx
OPENCODE_API_KEY=sk-xxxx

# --- optional (sane defaults below) ---
GPT_MODEL=gpt-5.6-sol
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
CLAUDE_MODEL=deepseek-v4-flash-vision-exp
CLAUDE_SONNET=deepseek-v4-pro
CLAUDE_OPUS=glm-5.3-flash
PI_PROVIDER=opencode-go-responses
PI_MODEL=muse-spark-1.3-contributor
